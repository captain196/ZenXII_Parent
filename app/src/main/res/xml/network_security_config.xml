<?xml version="1.0" encoding="utf-8"?>
<!--
  PRODUCTION (release) network security policy.
  - No cleartext: all traffic (ZenX backend + Firebase) must be HTTPS.
  - Trust only system CAs (NOT user-installed CAs) so a malicious/compromised
    device cannot MITM the parent's login + payment traffic via a user CA.
  Debug builds override this with src/debug/res/xml/network_security_config.xml
  (cleartext + user CAs) so the in-app Dev Settings BASE_URL override and local
  dev / proxy debugging keep working.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
