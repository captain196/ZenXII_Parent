<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY override. Merged over src/main for debug builds only, so a release
  APK/AAB is unaffected (it uses the secure src/main policy).
  Permits cleartext (HTTP) to any host + trusts user CAs so the in-app Dev
  Settings BASE_URL override works against localhost / LAN IP / ngrok, and so
  a debugging proxy (e.g. Charles) can be used during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
